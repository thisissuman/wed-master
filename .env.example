# Copy this file to .env. Values prefixed EXPO_PUBLIC_ are safe to expose in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional public runtime DSN. Leave blank to disable Sentry in the app.
EXPO_PUBLIC_SENTRY_DSN=

# Private build-time Sentry upload configuration. Never prefix these with EXPO_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://sentry.io/
